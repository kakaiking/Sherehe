# Copy to .env — never commit real secrets.
NODE_ENV=development
PORT=8787
CLIENT_ORIGIN=http://localhost:5173

# Postgres (local compose). Neon sets DATABASE_URL on Vercel.
DATABASE_URL=postgres://sherehe:local-dev-only@127.0.0.1:5433/sherehe

SESSION_SECRET=change-me-to-a-long-random-string
TICKET_SIGNING_SECRET=change-me-ticket-hmac
COOKIE_SECURE=false

# Upstash Redis (required on Vercel / production). Leave empty for local memory rate limits.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Optional staff bootstrap on migrate/seed. Sign-in is Google; set STAFF_EMAIL
# to the Google account that should have the admin portal.
STAFF_EMAIL=kakaiphil@gmail.com
STAFF_PASSWORD=change-me-staff
STAFF_PHONE=254700000000

# Google OAuth (Cloud Console web client). Redirect must be the app origin
# so the session cookie stays first-party via the /v1 proxy (Vite or Vercel).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://localhost:5173/v1/auth/google/callback

# Daraja — leave MODE=mock for local tests (no live STK).
# Live requires key, secret, shortcode, passkey, and an https callback Daraja can reach.
MPESA_MODE=mock
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_CALLBACK_URL=https://example.invalid/v1/payments/mpesa/callback
MPESA_ENV=sandbox
